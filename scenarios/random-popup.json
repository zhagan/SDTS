{
  "name": "Random Pop-up",
  "description": "Appears for 3 seconds, hides for 1–3 seconds, then appears elsewhere for 4 seconds.",
  "seed": 42,
  "arena": { "width_mm": 1600, "height_mm": 1000 },
  "targets": [
    {
      "id": "popup",
      "display": {
        "shape": "circle",
        "radius_mm": 75,
        "fill": "#ef8354",
        "stroke": "#d9683c"
      },
      "repeat": true,
      "sequence": [
        {
          "action": "show",
          "duration_secs": 3,
          "position": {
            "type": "random",
            "margin_mm": 25,
            "minimum_distance_mm": 300
          }
        },
        {
          "action": "hide",
          "duration_secs": { "random": { "min": 1, "max": 3 } }
        },
        {
          "action": "show",
          "duration_secs": 4,
          "position": {
            "type": "random",
            "margin_mm": 25,
            "minimum_distance_mm": 300
          }
        },
        {
          "action": "hide",
          "duration_secs": { "random": { "min": 1, "max": 3 } }
        }
      ]
    }
  ]
}
